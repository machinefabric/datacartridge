[package]
name = "datacartridge"
version = "{{ project.version }}"
edition = "2021"
license = "AGPL-3.0-or-later"
description = "JSON/YAML/CSV format conversion cartridge for MachineFabric"

[[bin]]
name = "datacartridge"
path = "src/main.rs"

[dependencies]
anyhow = "1.0"
ciborium = "0.2"
csv = "1.3"
serde_json = "1.0"
serde_yaml = "0.9"
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }
tracing = "0.1"

[dependencies.capdag]
{%- if env.MFR_LOCAL_LIBS %}
# MFR_LOCAL_LIBS was set when this was rendered: the working copy in this
# workspace rather than a published tag. Re-render without it before
# committing or releasing — a path resolves on this machine only.
path = "{{ projects.capdag_rs.path_from_here }}"
{%- else %}
git = "https://github.com/machinefabric/capdag-rs"
tag = "v{{ projects.capdag_rs.latest_remote_version }}"
{%- endif %}

[dependencies.machfab-cartridge-sdk]
path = "../../machfab-cartridge-sdk"

[dependencies.serde]
features = ["derive"]
version = "1.0"
