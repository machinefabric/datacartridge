# The cartridge, and the crates its series steps and forecasts are made from (crates/).
# They are datacartridge's: marketcartridge takes datacartridge-core and datacartridge-quant
# from here, and MarketOS is to consume them rather than own its own copies.
[workspace]
resolver = "3"
members = [".", "crates/*"]

[workspace.lints.clippy]
type_complexity = "allow"
too_many_arguments = "allow"
needless_range_loop = "allow"

[package]
name = "datacartridge"
version = "{{ project.version }}"
edition = "2021"
license = "AGPL-3.0-or-later"
description = "JSON/YAML/CSV format conversion cartridge for CapDAG"

[[bin]]
name = "datacartridge"
path = "src/main.rs"

[dependencies]
anyhow = "1.0"
ciborium = "0.2"
csv = "1.3"
serde_json = "1.0"
serde_yaml = "0.9"
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }
tracing = "0.1"

[dependencies.capdag]
{%- if env.MFR_LIBS == "working" %}
# MFR_LIBS was "working" when this was rendered: the working copy in this
# workspace rather than a published tag. Re-render without it before
# committing or releasing — a path resolves on this machine only.
path = "{{ projects.capdag_rs.path_from_here }}"
{%- elif env.MFR_LIBS == "channel" %}
# MFR_LIBS "channel": the release fetched under the build root, in place of the public one.
path = "{{ build.root_from_here }}/libraries/capdag-rs/{{ projects.capdag_rs.version }}/capdag-rs-{{ projects.capdag_rs.version }}"
{%- else %}
git = "https://github.com/machinefabric/capdag-rs"
tag = "v{{ projects.capdag_rs.latest_remote_version }}"
{%- endif %}

# The series steps, forecasts and the proved model they decide by (see crates/).
[dependencies.datacartridge-core]
path = "crates/datacartridge-core"

[dependencies.datacartridge-formal]
path = "crates/datacartridge-formal"

[dependencies.datacartridge-quant]
path = "crates/datacartridge-quant"

[dependencies.serde]
features = ["derive"]
version = "1.0"

{%- if env.MFR_LIBS == "channel" %}

# MFR_LIBS "channel": the libraries the graph pins by version, from the releases fetched under
# the build root, in place of crates.io.
[patch.crates-io]
lungo = { path = "{{ build.root_from_here }}/libraries/lungo/{{ projects.lungo_rs.version }}/lungo-{{ projects.lungo_rs.version }}" }
lungo-runtime = { path = "{{ build.root_from_here }}/libraries/lungo/{{ projects.lungo_rs.version }}/lungo-runtime-{{ projects.lungo_rs.version }}" }
tagged-urn = { path = "{{ build.root_from_here }}/libraries/tagged-urn-rs/{{ projects.tagged_urn_rs.version }}/tagged-urn-{{ projects.tagged_urn_rs.version }}" }
{%- endif %}
