[package]
name = "datacartridge"
version = "{{ project.version }}"
edition = "2021"
license = "AGPL-3.0-or-later"
description = "JSON/YAML/CSV format conversion cartridge for MachineFabric"

[[bin]]
name = "datacartridge"
path = "src/main.rs"

[dependencies]
anyhow = "1.0"
ciborium = "0.2"
csv = "1.3"
serde_json = "1.0"
serde_yaml = "0.9"
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }
tracing = "0.1"

[dependencies.capdag]
path = "../capdag"

[dependencies.machfab-cartridge-sdk]
path = "../machfab-cartridge-sdk"

[dependencies.serde]
features = ["derive"]
version = "1.0"
