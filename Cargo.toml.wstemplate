# The cartridge, and the MarketOS crates its series steps are made from: copied from
# MarketOS's workspace into crates/ with their own manifests, so the copied code compiles
# as it is.
[workspace]
resolver = "3"
members = [".", "crates/*"]

[workspace.lints.clippy]
type_complexity = "allow"
too_many_arguments = "allow"
needless_range_loop = "allow"

[package]
name = "datacartridge"
version = "{{ project.version }}"
edition = "2021"
license = "AGPL-3.0-or-later"
description = "JSON/YAML/CSV format conversion cartridge for CapDAG"

[[bin]]
name = "datacartridge"
path = "src/main.rs"

[dependencies]
anyhow = "1.0"
ciborium = "0.2"
csv = "1.3"
serde_json = "1.0"
serde_yaml = "0.9"
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }
tracing = "0.1"

[dependencies.capdag]
{%- if env.MFR_LOCAL_LIBS %}
# MFR_LOCAL_LIBS was set when this was rendered: the working copy in this
# workspace rather than a published tag. Re-render without it before
# committing or releasing — a path resolves on this machine only.
path = "{{ projects.capdag_rs.path_from_here }}"
{%- else %}
git = "https://github.com/machinefabric/capdag-rs"
tag = "v{{ projects.capdag_rs.latest_remote_version }}"
{%- endif %}

# MarketOS's series steps (see crates/).
[dependencies.mos-core]
path = "crates/mos-core"

[dependencies.mos-formal]
path = "crates/mos-formal"

[dependencies.mos-quant]
path = "crates/mos-quant"

[dependencies.serde]
features = ["derive"]
version = "1.0"
