# The code datacartridge's forecasts decide by: the `spec` module, generated from the proved
# model in ../../formal by `lungo generate` (see ../../lungo.toml) and checked in.
[package]
name = "datacartridge-formal"
version = "0.1.0"
edition = "2024"
license = "Apache-2.0"
publish = false

[dependencies]
serde = { version = "1.0", features = ["derive"] }

# The runtime the generated code runs on. The generated code is lungo's of the same
# version, so the runtime is pinned exactly.
[dependencies.lungo]
features = ["serde"]
{%- if env.MFR_LOCAL_LIBS %}
# MFR_LOCAL_LIBS was set when this was rendered: the working copy in this
# workspace rather than a published release. Re-render without it before
# committing or releasing — a path resolves on this machine only.
path = "{{ projects.lungo_rs.path_from_here }}/crates/lungo"
{%- else %}
version = "={{ projects.lungo_rs.latest_remote_version }}"
{%- endif %}
